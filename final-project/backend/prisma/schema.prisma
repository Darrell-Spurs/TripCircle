generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  email                String               @unique
  passwordHash         String?
  name                 String
  avatarUrl            String?
  provider             String
  trips                Trip[]               @relation("OwnerTrips")
  tripMembers          TripMember[]
  events               Event[]
  createdActivities    Activity[]            @relation("CreatedActivities")
  activityParticipants ActivityParticipant[]
  activityComments     ActivityComment[]
  activityCostShares   ActivityCostShare[]
  activityPreferences  ActivityPreference[]
  activityHistory      ActivityHistory[]
  tripComments         TripComment[]
  addedPhotos          TripPhoto[]          @relation("AddedPhotos")
  locationFolders       LocationFolder[]
  locationFolderMembers LocationFolderMember[] @relation("LocationFolderMembers")
  createdAt            DateTime             @default(now())
}

model Trip {
  id          Int          @id @default(autoincrement())
  ownerId     Int
  owner       User         @relation("OwnerTrips", fields: [ownerId], references: [id])
  title       String
  description String?
  body        String?
  coverImage  String?
  startDate   DateTime
  endDate     DateTime
  status      String
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  members     TripMember[]
  activities  Activity[]
  shareLinks  ShareLink[]
  events      Event[]
  tripComments TripComment[]
  photos      TripPhoto[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TripMember {
  id     Int   @id @default(autoincrement())
  tripId Int
  userId Int
  role   String
  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Activity {
  id              Int                  @id @default(autoincrement())
  tripId          Int
  date            DateTime
  startTime       DateTime?
  endTime         DateTime?
  title           String
  notes           String?
  body            String?
  placeId         String?
  locationName    String?
  address         String?
  lat             Float?
  lng             Float?
  orderIndex      Int
  createdByUserId Int?
  cost            Float?
  currency        String?
  activityType    String               @default("regular") // "regular", "gathering_point", "branch_point", or "merge_point"
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  trip            Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("CreatedActivities", fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants    ActivityParticipant[]
  comments        ActivityComment[]
  costShares      ActivityCostShare[]
  preferences     ActivityPreference[]
  tags            ActivityTag[]
  history         ActivityHistory[]
  fromTransportSegments TransportationSegment[] @relation("FromActivity")
  toTransportSegments   TransportationSegment[] @relation("ToActivity")
}

model ShareLink {
  id         Int      @id @default(autoincrement())
  tripId     Int
  token      String   @unique
  permission String
  expiresAt  DateTime?
  trip       Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Event {
  id        Int      @id @default(autoincrement())
  userId    Int?
  tripId    Int?
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
}

model ActivityParticipant {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([activityId, userId])
}

model ActivityComment {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  content    String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ActivityCostShare {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  amount     Float
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([activityId, userId])
}

model ActivityPreference {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  preference String   // "interested" or "not_interested"
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([activityId, userId])
}

model ActivityHistory {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  action     String   // "created", "updated", "deleted"
  changes    Json?
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model ActivityTag {
  id         Int      @id @default(autoincrement())
  activityId Int
  tag        String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([activityId, tag])
  @@index([tag])
}

model TripComment {
  id        Int      @id @default(autoincrement())
  tripId    Int
  userId    Int
  content   String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripPhoto {
  id            Int      @id @default(autoincrement())
  tripId        Int
  url           String
  caption       String?
  isPublic      Boolean  @default(false)
  isFeedCover   Boolean  @default(false)
  addedByUserId Int
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  addedBy       User     @relation("AddedPhotos", fields: [addedByUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LocationFolder {
  id          Int                      @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  isPublic    Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  owner       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations   SavedLocation[]
  shareLinks  LocationFolderShareLink[]
  members     LocationFolderMember[]

  @@index([userId])
}

model SavedLocation {
  id        Int            @id @default(autoincrement())
  folderId  Int
  name      String
  address   String
  lat       Float
  lng       Float
  placeId   String
  notes     String?
  tags      Json?          // Array of strings
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  folder    LocationFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

model LocationFolderShareLink {
  id         Int            @id @default(autoincrement())
  folderId   Int
  token      String         @unique
  permission String
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  folder     LocationFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([token])
}

model LocationFolderMember {
  id        Int            @id @default(autoincrement())
  folderId  Int
  userId    Int
  role      String
  createdAt DateTime       @default(now())
  folder    LocationFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User           @relation("LocationFolderMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
}

model TransportationSegment {
  id                Int       @id @default(autoincrement())
  fromActivityId    Int
  toActivityId      Int
  manualStartTime   DateTime?
  manualEndTime     DateTime?
  isManualOverride  Boolean   @default(false)
  transportationMode String?  // 'driving', 'walking', 'bicycling', 'transit'
  note              String?   // Note for this transportation segment
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  fromActivity      Activity  @relation("FromActivity", fields: [fromActivityId], references: [id], onDelete: Cascade)
  toActivity        Activity  @relation("ToActivity", fields: [toActivityId], references: [id], onDelete: Cascade)

  @@unique([fromActivityId, toActivityId])
  @@index([fromActivityId])
  @@index([toActivityId])
}

