generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  provider     String
  trips        Trip[]   @relation("OwnerTrips")
  tripMembers  TripMember[]
  events       Event[]
  createdAt    DateTime @default(now())
}

model Trip {
  id          Int          @id @default(autoincrement())
  ownerId     Int
  owner       User         @relation("OwnerTrips", fields: [ownerId], references: [id])
  title       String
  description String?
  coverImage  String?
  startDate   DateTime
  endDate     DateTime
  status      String
  members     TripMember[]
  activities  Activity[]
  shareLinks  ShareLink[]
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TripMember {
  id     Int   @id @default(autoincrement())
  tripId Int
  userId Int
  role   String
  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Activity {
  id           Int      @id @default(autoincrement())
  tripId       Int
  date         DateTime
  startTime    DateTime?
  endTime      DateTime?
  title        String
  notes        String?
  placeId      String?
  locationName String?
  address      String?
  lat          Float?
  lng          Float?
  orderIndex   Int
  trip         Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ShareLink {
  id         Int      @id @default(autoincrement())
  tripId     Int
  token      String   @unique
  permission String
  expiresAt  DateTime?
  trip       Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Event {
  id        Int      @id @default(autoincrement())
  userId    Int?
  tripId    Int?
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
}

