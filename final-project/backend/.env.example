# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/tripcircle
DATABASE_URL=postgresql://user:password@localhost:5432/tripcircle

# ============================================
# JWT Authentication
# ============================================
# Secret key for signing JWT tokens
# Generate a strong random secret for production (e.g., using: openssl rand -hex 32)
# IMPORTANT: Change this in production! Never use the default value in production.
JWT_SECRET=dev-secret-key-change-in-production

# ============================================
# Google OAuth Configuration
# ============================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project or select existing one
# 2. Enable Google+ API
# 3. Go to Credentials > Create Credentials > OAuth 2.0 Client ID
# 4. Set authorized redirect URI: http://localhost:8000/auth/google/callback (for dev)
#    For production: https://your-backend-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Google Places API
# ============================================
# Get this from Google Cloud Console
# 1. Enable Places API (New) or Places API (Legacy)
# 2. Go to Credentials > Create Credentials > API Key
# 3. Restrict the API key to Places API for security
# Used for searching tourist attractions and points of interest
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ============================================
# Amplitude Analytics
# ============================================
# Get this from Amplitude dashboard: https://amplitude.com/
# Used for tracking user events and analytics
AMPLITUDE_API_KEY=your-amplitude-api-key

# ============================================
# Server Configuration
# ============================================
# Port number for the backend server
PORT=8000

# Environment: development, production, or test
NODE_ENV=development

# ============================================
# Note: CORS Origins
# ============================================
# CORS origins are currently hardcoded in src/index.ts
# For production, you may want to add FRONTEND_URL environment variable
# and update the CORS configuration to use it
