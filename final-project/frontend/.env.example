# ============================================
# API Configuration
# ============================================
# Backend API base URL
# For local development: http://localhost:8000
# For production: https://your-backend-domain.com
# Make sure this matches your backend server URL
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# Google Maps API
# ============================================
# Get this from Google Cloud Console
# 1. Enable Maps JavaScript API
# 2. Go to Credentials > Create Credentials > API Key
# 3. Restrict the API key to Maps JavaScript API for security
# Used for displaying maps and places in the Explore page
# Note: This is different from GOOGLE_PLACES_API_KEY (backend uses that for search)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# Amplitude Analytics
# ============================================
# Get this from Amplitude dashboard: https://amplitude.com/
# Used for frontend analytics tracking
# Should match the AMPLITUDE_API_KEY in backend (or use a separate key if needed)
VITE_AMPLITUDE_API_KEY=your-amplitude-api-key
